# Discord Bot Settings
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CHANNEL_ID=123456789012345678

# LLM API Settings (使用するAPIのいずれかを設定)
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# 使用するLLMプロバイダ (openai または anthropic)
LLM_PROVIDER=anthropic

# TimeTree Settings
TIMETREE_EMAIL=your_timetree_email
TIMETREE_PASSWORD=your_timetree_password
TIMETREE_CALENDAR_NAME=My Calendar  # 目的のカレンダー名

# Selenium Settings
HEADLESS=true  # ヘッドレスモードで実行するか
